APP_NAME=autodoc_center
APP_ENV=PROD
ALLOW_PRODUCTION_UPLOAD=false
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://sua-api-producao.exemplo.com

# Segurança API/n8n/painel
AUTODOC_API_KEY=
REQUIRE_API_KEY=true
CORS_ALLOW_ORIGINS=https://seu-painel.exemplo.com
PROD_ALLOWED_PROJECTS=
PROD_MIN_AUTO_SCORE=95
N8N_FALLBACK_IS_SUCCESS=false
REQUIRE_FILE_ID_FOR_PIPELINE=true
REQUIRE_LOGIN_FOR_AUTODOC_DOWNLOAD=true
REQUIRE_LOCAL_PATH_FOR_UPLOAD=true

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Microsoft Graph / SharePoint
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_TOKEN_REFRESH_MARGIN_SECONDS=300
GRAPH_TIMEOUT_SECONDS=60

SHAREPOINT_HOSTNAME=
SHAREPOINT_DEFAULT_LIBRARY_NAME=Documentos
SHAREPOINT_HML_ROOT=_AUTODOC_HOMOLOGACAO
SHAREPOINT_PROD_ROOT=
SHAREPOINT_OBSOLETE_FOLDER=_OBSOLETOS
SHAREPOINT_PENDING_FOLDER=_PENDENTES
SHAREPOINT_ERROR_FOLDER=_ERROS
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# AutoDoc
AUTODOC_URL=
AUTODOC_LOGIN_URL=
AUTODOC_USER=
AUTODOC_PASSWORD=
AUTODOC_PROFILE_DIR=storage/browser_profile
AUTODOC_HEADLESS=true
AUTODOC_SEARCH_SELECTOR=input[type='search']
AUTODOC_DOWNLOAD_SELECTOR=button:has-text('Download'), a:has-text('Download'), button:has-text('Baixar'), a:has-text('Baixar')
AUTODOC_LOGIN_SUCCESS_TEXT=Logout,Sair,Projetos

# n8n / regras
N8N_OUTLOOK_FOLDER=Autodoc
N8N_API_BASE_URL=https://sua-api-producao.exemplo.com
MIN_AUTO_SCORE=90
MIN_REVIEW_SCORE=70
ENABLE_SHAREPOINT_UPLOAD=true
ENABLE_AUTODOC_ROBOT=true
ENABLE_OBSOLETE_RULE=true
ENABLE_N8N_AUTOMATION=true
