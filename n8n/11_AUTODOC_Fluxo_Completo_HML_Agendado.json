      "id": "6e0df849-a6b7-40e7-9803-5234a19ec983",
      "name": "POST /emails/{id}/parse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const files = $json.files || [];\nif (!files.length) {\n  return [{\n    json: {\n      ok: false,\n      stop_reason: 'PARSER_SEM_ARQUIVOS',\n      message: 'Parser não criou arquivos. Isso é esperado até o parser reconhecer o modelo real do relatório Autodoc.',\n      email_type: $json.email_type || 'DESCONHECIDO',\n      original: $json\n    }\n  }];\n}\n\nlet sourceBinary = {};\ntry {\n  sourceBinary = $('Buscar email Autodoc').item.binary || $('Buscar email com anexos').item.binary || {};\n} catch (e) {\n  sourceBinary = {};\n}\n\nfunction norm(v) {\n  return String(v || '')\n    .toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .trim();\n}\n\nconst out = [];\nfor (const f of files) {\n  let matchedKey = null;\n  const fn = norm(f.file_name || f.filename || f.name);\n  for (const [key, bin] of Object.entries(sourceBinary)) {\n    const bn = norm(bin.fileName || bin.file_name);\n    if (bn && fn && bn === fn) {\n      matchedKey = key;\n      break;\n    }\n  }\n  const item = { json: { ...f, matched_binary_key: matchedKey } };\n  if (matchedKey) item.binary = { file: sourceBinary[matchedKey] };\n  out.push(item);\n}\nreturn out;"
      },
