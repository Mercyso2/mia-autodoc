    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Config').item.json.apiBaseUrl}}/emails/{{$json.email_id}}/parse",
        "responseFormat": "json",
        "options": {
          "ignoreResponseCode": false
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-AUTODOC-API-KEY",
              "value": "={{$env.AUTODOC_API_KEY || ''}}"
            },
